<Window x:Class="Morphdrop.Overlay.WheelWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:Morphdrop.Overlay"
        Title="Morphdrop"
        Width="360" Height="360" Left="-10000" Top="-10000"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" AllowDrop="True">
    <Grid>
        <!-- Almost invisible disc (alpha 1/255). Fully transparent pixels of a layered window let the mouse and
             drops fall through to the window below, so this disc is what makes the wheel a drop target, even while
             the visible wheel is still hidden. Everything else ignores hit testing. -->
        <Ellipse Width="340" Height="340" Fill="#01000000" />
        <overlay:WheelView x:Name="Wheel" Opacity="0" />
    </Grid>
</Window>
