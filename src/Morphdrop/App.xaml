<Application x:Class="Morphdrop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- Shared by the editor and settings windows. The Theme.* brushes start light; AppTheme swaps them for dark ones. -->
    <Application.Resources>
        <SolidColorBrush x:Key="Theme.Window" Color="#F3F3F3" />
        <SolidColorBrush x:Key="Theme.Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Theme.PanelBorder" Color="#E3E3E3" />
        <SolidColorBrush x:Key="Theme.Text" Color="#1F1F1F" />
        <SolidColorBrush x:Key="Theme.SubtleText" Color="#707070" />
        <SolidColorBrush x:Key="Theme.Button" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Theme.ButtonBorder" Color="#D0D0D0" />
        <SolidColorBrush x:Key="Theme.Chip" Color="#ECECEC" />
        <SolidColorBrush x:Key="Theme.ChipHover" Color="#E0E0E0" />
        <SolidColorBrush x:Key="Theme.Accent" Color="#FF5F3A" />

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Theme.Button}" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ButtonBorder}" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="{DynamicResource Theme.Chip}" CornerRadius="14" Padding="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.ChipHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The system style colours check boxes with a fixed system colour, which would stay black on a dark window.
             Plain text needs no style: it inherits the window's Theme.Text foreground (a TextBlock style would also
             recolour the white text inside accent buttons and selected chips). -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        </Style>
    </Application.Resources>
</Application>
