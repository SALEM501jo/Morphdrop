<Window x:Class="ShiftDrop.Editing.EditorWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShiftDrop" Width="1080" Height="760" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1F1F1F">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FF5F3A" />
            <Setter Property="BorderBrush" Value="#FF5F3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="#ECECEC" CornerRadius="14" Padding="12,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E0E0E0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF5F3A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E3E3E3" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource ActionButton}" Margin="0,0,8,0" IsCancel="True" />
                    <Button x:Name="SaveButton" Content="Save copy" Style="{StaticResource AccentButton}" IsDefault="True" IsEnabled="False" />
                </StackPanel>
                <ContentControl x:Name="OptionsHost" VerticalAlignment="Center" Focusable="False" />
            </DockPanel>
        </Border>
        <Grid Margin="24">
            <TextBlock x:Name="Status" Text="Opening…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#666666" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" />
            <ContentControl x:Name="EditorHost" Focusable="False" />
        </Grid>
    </DockPanel>
</Window>
