<UserControl x:Class="ShiftDrop.Overlay.WheelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" Height="360"
             FontFamily="Segoe UI"
             IsHitTestVisible="False">
    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.3" Color="#000000" />
        </Grid.Effect>

        <!-- Frosted ring behind the slices -->
        <Ellipse Width="336" Height="336" Fill="#73FFFFFF" Stroke="#B3FFFFFF" StrokeThickness="1" />

        <Canvas x:Name="SliceLayer" Width="360" Height="360" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="SliceTurn" Angle="0" />
            </Canvas.RenderTransform>
        </Canvas>

        <Border Width="116" Height="116" CornerRadius="58"
                Background="#F7FFFFFF" BorderBrush="#1F000000" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" Margin="12,0">
                <TextBlock x:Name="HubTitle" FontSize="17" FontWeight="SemiBold" Foreground="#1F1F1F"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HubSubtitle" FontSize="11" Foreground="#5C5C5C" Margin="0,2,0,0"
                           TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" />
                <TextBlock x:Name="HubHint" FontSize="10" FontWeight="SemiBold" Foreground="#FF5F3A" Margin="0,4,0,0"
                           TextAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
